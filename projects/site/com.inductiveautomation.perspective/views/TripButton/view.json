{
  "custom": {
    "active": false
  },
  "params": {
    "inverter": 1
  },
  "propConfig": {
    "params.inverter": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.active": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "{[default]PlantController/TripInverter} = {view.params.inverter}"
        }
      }
    }
  },
  "props": {
    "defaultSize": {
      "width": 160,
      "height": 56
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "padding": "2px 2px 9px 2px"
      }
    },
    "children": [
      {
        "type": "ia.input.button",
        "meta": {
          "name": "Trip"
        },
        "position": {
          "grow": 1
        },
        "props": {
          "text": "Trip inverter",
          "style": {
            "backgroundColor": "#c62828",
            "border": "1px solid #7a1914",
            "borderRadius": "8px",
            "boxShadow": "0 4px 0 #7a1914, 0 6px 10px rgba(0,0,0,0.25)",
            "color": "#ffffff",
            "cursor": "pointer",
            "fontWeight": "600",
            "transform": "translateY(0px)",
            "transition": "all 0.1s ease"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.active}, \"Inverter \" + toStr({view.params.inverter}) + \" TRIPPED\", \"Trip inverter \" + toStr({view.params.inverter}))"
              }
            }
          },
          "props.style.backgroundColor": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.active}, \"#8c1d18\", \"#c62828\")"
              }
            }
          },
          "props.style.boxShadow": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.active}, \"inset 0 3px 8px rgba(0,0,0,0.5)\", \"0 4px 0 #7a1914, 0 6px 10px rgba(0,0,0,0.25)\")"
              }
            }
          },
          "props.style.transform": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.active}, \"translateY(4px)\", \"translateY(0px)\")"
              }
            }
          }
        },
        "events": {
          "component": {
            "onActionPerformed": {
              "type": "script",
              "scope": "G",
              "config": {
                "script": "\tsystem.tag.writeBlocking([\"[default]PlantController/TripInverter\"], [int(self.view.params.inverter)])"
              }
            }
          }
        }
      }
    ]
  }
}
