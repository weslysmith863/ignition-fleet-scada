{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "width": 1100,
      "height": 56
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "row",
      "justify": "space-between",
      "alignItems": "center",
      "style": {
        "backgroundColor": "#1b2733",
        "padding": "0 12px"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Title"
        },
        "position": {
          "basis": "auto"
        },
        "props": {
          "text": "Site 1  ·  simulated solar plant",
          "style": {
            "color": "#ffffff",
            "fontSize": "18px",
            "fontWeight": "600"
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Links"
        },
        "position": {
          "basis": "auto"
        },
        "props": {
          "direction": "row",
          "alignItems": "center"
        },
        "children": [
          {
            "type": "ia.navigation.link",
            "meta": {
              "name": "OverviewLink"
            },
            "props": {
              "text": "Overview",
              "url": "/",
              "style": {
                "color": "#cfe3f7",
                "fontSize": "14px",
                "padding": "8px 14px",
                "textDecoration": "none"
              }
            }
          },
          {
            "type": "ia.navigation.link",
            "meta": {
              "name": "TrendsLink"
            },
            "props": {
              "text": "Trends",
              "url": "/trends",
              "style": {
                "color": "#cfe3f7",
                "fontSize": "14px",
                "padding": "8px 14px",
                "textDecoration": "none"
              }
            }
          },
          {
            "type": "ia.navigation.link",
            "meta": {
              "name": "ControllerLink"
            },
            "props": {
              "text": "Controller",
              "url": "/controller",
              "style": {
                "color": "#cfe3f7",
                "fontSize": "14px",
                "padding": "8px 14px",
                "textDecoration": "none"
              }
            }
          }
        ]
      }
    ]
  }
}
