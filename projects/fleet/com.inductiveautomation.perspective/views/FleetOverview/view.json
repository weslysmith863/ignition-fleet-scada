{
  "custom": {
    "sites": [],
    "totals": {
      "output": 0,
      "rated": 0,
      "count": 0
    }
  },
  "params": {},
  "propConfig": {
    "custom.sites": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "1"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\tresults = system.tag.browse(\"\").getResults()\n\tnames = [str(r[\"name\"]) for r in results]\n\treturn sorted([n for n in names if n not in (\"System\", \"default\")], key=lambda n: (len(n), n))"
          }
        ]
      }
    },
    "custom.totals": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "now(5000)"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\tresults = system.tag.browse(\"\").getResults()\n\tsites = [str(r[\"name\"]) for r in results if str(r[\"name\"]) not in (\"System\", \"default\")]\n\tpaths = []\n\tfor s in sites:\n\t\tpaths.append(\"[%s]Meter/POI_MW\" % s)\n\t\tpaths.append(\"[%s]Site/RatedMW\" % s)\n\tvalues = system.tag.readBlocking(paths) if paths else []\n\toutput = sum([values[i].value for i in range(0, len(values), 2) if values[i].quality.isGood()])\n\trated = sum([values[i].value for i in range(1, len(values), 2) if values[i].quality.isGood()])\n\treturn {\"output\": output, \"rated\": rated, \"count\": len(sites)}"
          }
        ]
      }
    }
  },
  "props": {
    "defaultSize": {
      "width": 1100,
      "height": 700
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "#f3f5f7"
      }
    },
    "children": [
      {
        "type": "ia.display.view",
        "meta": {
          "name": "Header"
        },
        "position": {
          "basis": "auto",
          "shrink": 0
        },
        "props": {
          "path": "Header",
          "useDefaultViewHeight": true
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Content"
        },
        "position": {
          "grow": 1
        },
        "props": {
          "direction": "column",
          "style": {
            "padding": "20px",
            "gap": "16px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Title"
            },
            "position": {
              "basis": "auto"
            },
            "props": {
              "text": "Fleet at a glance",
              "style": {
                "color": "#1b2733",
                "fontSize": "20px",
                "fontWeight": "600"
              }
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "Totals"
            },
            "position": {
              "basis": "auto",
              "shrink": 0
            },
            "props": {
              "direction": "row",
              "style": {
                "gap": "16px"
              }
            },
            "children": [
              {
                "type": "ia.display.view",
                "meta": {
                  "name": "FleetOutput"
                },
                "position": {
                  "grow": 1,
                  "basis": "0"
                },
                "props": {
                  "path": "Kpi",
                  "useDefaultViewHeight": true,
                  "params": {
                    "title": "Fleet output",
                    "text": "",
                    "accent": "#1b2733"
                  }
                },
                "propConfig": {
                  "props.params.text": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "numberFormat({view.custom.totals.output}, '0.00') + \" MW\""
                      }
                    }
                  }
                }
              },
              {
                "type": "ia.display.view",
                "meta": {
                  "name": "FleetRating"
                },
                "position": {
                  "grow": 1,
                  "basis": "0"
                },
                "props": {
                  "path": "Kpi",
                  "useDefaultViewHeight": true,
                  "params": {
                    "title": "Fleet rating",
                    "text": "",
                    "accent": "#1b2733"
                  }
                },
                "propConfig": {
                  "props.params.text": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "numberFormat({view.custom.totals.rated}, '0.0') + \" MW\""
                      }
                    }
                  }
                }
              },
              {
                "type": "ia.display.view",
                "meta": {
                  "name": "SiteCount"
                },
                "position": {
                  "grow": 1,
                  "basis": "0"
                },
                "props": {
                  "path": "Kpi",
                  "useDefaultViewHeight": true,
                  "params": {
                    "title": "Sites",
                    "text": "",
                    "accent": "#1b2733"
                  }
                },
                "propConfig": {
                  "props.params.text": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "toStr({view.custom.totals.count})"
                      }
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "SitesTitle"
            },
            "position": {
              "basis": "auto"
            },
            "props": {
              "text": "Sites",
              "style": {
                "color": "#1b2733",
                "fontSize": "16px",
                "fontWeight": "600"
              }
            }
          },
          {
            "type": "ia.display.flex-repeater",
            "meta": {
              "name": "SiteCards"
            },
            "position": {
              "basis": "auto",
              "shrink": 0
            },
            "props": {
              "path": "SiteCard",
              "direction": "row",
              "wrap": "wrap",
              "useDefaultViewWidth": false,
              "useDefaultViewHeight": true,
              "elementPosition": {
                "grow": 1,
                "shrink": 1,
                "basis": "320px"
              },
              "style": {
                "gap": "16px"
              },
              "instances": []
            },
            "propConfig": {
              "props.instances": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.custom.sites"
                  },
                  "transforms": [
                    {
                      "type": "script",
                      "code": "\treturn [{\"site\": s} for s in value]"
                    }
                  ]
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Footnote"
            },
            "position": {
              "basis": "auto"
            },
            "props": {
              "text": "Every site is read through a remote tag provider on this gateway. Simulated data. Personal learning project on Ignition Maker Edition.",
              "style": {
                "color": "#5f6b76",
                "fontSize": "12px"
              }
            }
          }
        ]
      }
    ]
  }
}
