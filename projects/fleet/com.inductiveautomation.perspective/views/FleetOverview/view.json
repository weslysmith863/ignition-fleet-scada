{
  "custom": {},
  "params": {},
  "propConfig": {
    "custom.sites": {
      "binding": {
        "config": {
          "expression": "1"
        },
        "transforms": [
          {
            "code": "\tresults = system.tag.browse(\"\").getResults()\n\tnames = [str(r[\"name\"]) for r in results]\n\treturn sorted([n for n in names if n not in (\"System\", \"default\")], key=lambda n: (len(n), n))",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.totals": {
      "binding": {
        "config": {
          "expression": "now(5000)"
        },
        "transforms": [
          {
            "code": "\tresults = system.tag.browse(\"\").getResults()\n\tsites = [str(r[\"name\"]) for r in results if str(r[\"name\"]) not in (\"System\", \"default\")]\n\tpaths = []\n\tfor s in sites:\n\t\tpaths.append(\"[%s]Meter/POI_MW\" % s)\n\t\tpaths.append(\"[%s]Site/RatedMW\" % s)\n\tvalues = system.tag.readBlocking(paths) if paths else []\n\toutput = sum([values[i].value for i in range(0, len(values), 2) if values[i].quality.isGood()])\n\trated = sum([values[i].value for i in range(1, len(values), 2) if values[i].quality.isGood()])\n\treporting = len([i for i in range(0, len(values), 2) if values[i].quality.isGood()])\n\treturn {\"output\": output, \"rated\": rated, \"count\": len(sites), \"reporting\": reporting}",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 700,
      "width": 1100
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Header"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "path": "Header",
          "useDefaultViewHeight": true
        },
        "type": "ia.display.view"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Title"
            },
            "props": {
              "style": {
                "color": "#1b2733",
                "fontSize": "20px",
                "fontWeight": "600"
              },
              "text": "Fleet at a glance"
            },
            "type": "ia.display.label"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "FleetOutput"
                },
                "position": {
                  "basis": "0",
                  "grow": 1
                },
                "propConfig": {
                  "props.params.text": {
                    "binding": {
                      "config": {
                        "expression": "numberFormat({view.custom.totals.output}, '0.00') + \" MW\""
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "params": {
                    "accent": "#1b2733",
                    "title": "Fleet output"
                  },
                  "path": "Kpi",
                  "useDefaultViewHeight": true
                },
                "type": "ia.display.view"
              },
              {
                "meta": {
                  "name": "FleetRating"
                },
                "position": {
                  "basis": "0",
                  "grow": 1
                },
                "propConfig": {
                  "props.params.text": {
                    "binding": {
                      "config": {
                        "expression": "numberFormat({view.custom.totals.rated}, '0.0') + \" MW\""
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "params": {
                    "accent": "#1b2733",
                    "title": "Fleet rating"
                  },
                  "path": "Kpi",
                  "useDefaultViewHeight": true
                },
                "type": "ia.display.view"
              },
              {
                "meta": {
                  "name": "SiteCount"
                },
                "position": {
                  "basis": "0",
                  "grow": 1
                },
                "propConfig": {
                  "props.params.accent": {
                    "binding": {
                      "config": {
                        "expression": "if({view.custom.totals.reporting} < {view.custom.totals.count}, '#c77700', '#1b2733')"
                      },
                      "type": "expr"
                    }
                  },
                  "props.params.text": {
                    "binding": {
                      "config": {
                        "expression": "toStr({view.custom.totals.reporting}) + \" of \" + toStr({view.custom.totals.count}) + \" reporting\""
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "params": {
                    "title": "Sites"
                  },
                  "path": "Kpi",
                  "useDefaultViewHeight": true
                },
                "type": "ia.display.view"
              }
            ],
            "meta": {
              "name": "Totals"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "style": {
                "gap": "16px"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "meta": {
              "name": "SitesTitle"
            },
            "props": {
              "style": {
                "color": "#1b2733",
                "fontSize": "16px",
                "fontWeight": "600"
              },
              "text": "Sites"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "SiteCards"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.instances": {
                "binding": {
                  "config": {
                    "path": "view.custom.sites"
                  },
                  "transforms": [
                    {
                      "code": "\treturn [{\"site\": s} for s in value]",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "elementPosition": {
                "basis": "320px"
              },
              "path": "SiteCard",
              "style": {
                "gap": "16px"
              },
              "useDefaultViewWidth": false,
              "wrap": "wrap"
            },
            "type": "ia.display.flex-repeater"
          },
          {
            "meta": {
              "name": "ReliabilityTitle"
            },
            "props": {
              "style": {
                "color": "#1b2733",
                "fontSize": "16px",
                "fontWeight": "600"
              },
              "text": "Reliability, last 24 hours"
            },
            "type": "ia.display.label"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "SiteTitle"
                },
                "position": {
                  "basis": "110px",
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "color": "#5f6b76",
                    "fontSize": "12px",
                    "letterSpacing": "0.04em",
                    "textTransform": "uppercase"
                  },
                  "text": "Site"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "EventsTitle"
                },
                "position": {
                  "basis": "110px",
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "color": "#5f6b76",
                    "fontSize": "12px",
                    "letterSpacing": "0.04em",
                    "textTransform": "uppercase"
                  },
                  "text": "Fault events"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "AcknowledgeTitle"
                },
                "position": {
                  "basis": "190px",
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "color": "#5f6b76",
                    "fontSize": "12px",
                    "letterSpacing": "0.04em",
                    "textTransform": "uppercase"
                  },
                  "text": "Mean time to acknowledge"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "ActiveTitle"
                },
                "position": {
                  "basis": "170px",
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "color": "#5f6b76",
                    "fontSize": "12px",
                    "letterSpacing": "0.04em",
                    "textTransform": "uppercase"
                  },
                  "text": "Mean time active"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "AvailabilityTitle"
                },
                "position": {
                  "grow": 1
                },
                "props": {
                  "style": {
                    "color": "#5f6b76",
                    "fontSize": "12px",
                    "letterSpacing": "0.04em",
                    "textTransform": "uppercase"
                  },
                  "text": "Availability"
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "ReliabilityColumns"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "alignItems": "center",
              "direction": "row",
              "style": {
                "gap": "8px",
                "padding": "0 13px"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "meta": {
              "name": "ReliabilityRows"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.instances": {
                "binding": {
                  "config": {
                    "expression": "now(30000)"
                  },
                  "transforms": [
                    {
                      "code": "\tresults = system.tag.browse(\"\").getResults()\n\tnames = sorted([str(r[\"name\"]) for r in results if str(r[\"name\"]) not in (\"System\", \"default\")], key=lambda n: (len(n), n))\n\tkpis = {}\n\tfor r in system.db.runPrepQuery(\"SELECT site, fault_events, mean_time_to_acknowledge_s, mean_time_active_s, availability_percent FROM site_kpis\", [], \"fleetdb\"):\n\t\tkpis[r[\"site\"]] = r\n\tdef span(seconds):\n\t\tif seconds is None:\n\t\t\treturn \"none yet\"\n\t\ts = int(round(seconds))\n\t\tif s < 60:\n\t\t\treturn \"%d s\" % s\n\t\tif s < 3600:\n\t\t\treturn \"%d min %d s\" % (s // 60, s % 60)\n\t\treturn \"%d h %d min\" % (s // 3600, (s % 3600) // 60)\n\trows = []\n\tfor n in names:\n\t\tif n in kpis:\n\t\t\tk = kpis[n]\n\t\t\trows.append({\"site\": n, \"events\": str(k[\"fault_events\"]), \"acknowledge\": span(k[\"mean_time_to_acknowledge_s\"]), \"active\": span(k[\"mean_time_active_s\"]), \"availability\": \"%.2f %%\" % float(k[\"availability_percent\"])})\n\t\telse:\n\t\t\trows.append({\"site\": n, \"events\": \"n/a\", \"acknowledge\": \"n/a\", \"active\": \"n/a\", \"availability\": \"n/a (no alarm data yet)\"})\n\treturn rows",
                      "type": "script"
                    }
                  ],
                  "type": "expr"
                }
              }
            },
            "props": {
              "direction": "column",
              "elementPosition": {
                "basis": "auto",
                "grow": 0,
                "shrink": 0
              },
              "path": "SiteKpiRow",
              "style": {
                "gap": "8px"
              },
              "useDefaultViewHeight": true,
              "useDefaultViewWidth": false
            },
            "type": "ia.display.flex-repeater"
          },
          {
            "meta": {
              "name": "ReliabilityNote"
            },
            "props": {
              "style": {
                "color": "#5f6b76",
                "fontSize": "12px"
              },
              "text": "Last 24 hours. Availability is our own simplification: time-based over all 24 hours, counting only faults whose reason counts against availability (a grid outage or curtailment does not), so a fault with no reason yet counts. Mean time active is how long the alarm stayed active, a stand-in for repair time. A site shows n/a when it has no alarm journal yet (ADR 0021)."
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Footnote"
            },
            "props": {
              "style": {
                "color": "#5f6b76",
                "fontSize": "12px"
              },
              "text": "Every site is read through a tag provider on this gateway: a remote one for a site gateway, a local one for an OEM-integrated site. Simulated data. Personal learning project on Ignition Maker Edition."
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Content"
        },
        "position": {
          "grow": 1
        },
        "props": {
          "direction": "column",
          "style": {
            "gap": "16px",
            "overflow": "auto",
            "padding": "20px"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "#f3f5f7"
      }
    },
    "type": "ia.container.flex"
  }
}
