{
  "custom": {
    "output": 0,
    "rated": 0,
    "sun": 0,
    "hasBattery": false,
    "batterySoc": 0,
    "batteryKw": 0,
    "reporting": true
  },
  "params": {
    "site": "site1"
  },
  "propConfig": {
    "params.site": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.output": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "[{site}]Meter/POI_MW",
          "references": {
            "site": "{view.params.site}"
          }
        }
      }
    },
    "custom.rated": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "[{site}]Site/RatedMW",
          "references": {
            "site": "{view.params.site}"
          }
        }
      }
    },
    "custom.sun": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "[{site}]Weather/POA_Wm2",
          "references": {
            "site": "{view.params.site}"
          }
        }
      }
    },
    "custom.reporting": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "{view.params.site} + \"|\" + toStr(now(5000))"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\tsite = value.split(\"|\")[0]\n\treturn system.tag.readBlocking([\"[%s]Meter/POI_MW\" % site])[0].quality.isGood()"
          }
        ]
      }
    },
    "custom.hasBattery": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "{view.params.site}"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\tresults = system.tag.browse(\"[%s]\" % value).getResults()\n\treturn len([r for r in results if str(r[\"name\"]) == \"Battery\"]) > 0"
          }
        ]
      }
    },
    "custom.batterySoc": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "[{site}]Battery/SoC_pct",
          "references": {
            "site": "{view.params.site}"
          }
        }
      }
    },
    "custom.batteryKw": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "[{site}]Battery/Power_kW",
          "references": {
            "site": "{view.params.site}"
          }
        }
      }
    }
  },
  "props": {
    "defaultSize": {
      "width": 340,
      "height": 225
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "justify": "space-between",
      "style": {
        "backgroundColor": "#ffffff",
        "border": "1px solid #d7dde3",
        "borderRadius": "8px",
        "padding": "12px 16px",
        "cursor": "pointer"
      }
    },
    "events": {
      "dom": {
        "onClick": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\tsystem.perspective.navigate(page=\"/site/\" + self.view.params.site)"
          }
        }
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Name"
        },
        "position": {
          "basis": "auto"
        },
        "props": {
          "text": "",
          "style": {
            "color": "#5f6b76",
            "fontSize": "12px",
            "textTransform": "uppercase",
            "letterSpacing": "0.04em"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.site"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Output"
        },
        "position": {
          "basis": "auto"
        },
        "props": {
          "text": "",
          "style": {
            "color": "#1b2733",
            "fontSize": "32px",
            "fontWeight": "600"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.reporting}, numberFormat({view.custom.output}, '0.00') + \" MW\", \"No data\")"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "OfRating"
        },
        "position": {
          "basis": "auto"
        },
        "props": {
          "text": "",
          "style": {
            "color": "#5f6b76",
            "fontSize": "13px"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.reporting}, if({view.custom.rated} > 0, numberFormat({view.custom.output} / {view.custom.rated} * 100, '0') + \"% of the \" + numberFormat({view.custom.rated}, '0.0') + \" MW rating\", \"\"), \"No good reading from this site's meter\")"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Sunlight"
        },
        "position": {
          "basis": "auto"
        },
        "props": {
          "text": "",
          "style": {
            "color": "#5f6b76",
            "fontSize": "13px"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.reporting}, \"Sunlight on the panels: \" + numberFormat({view.custom.sun}, '0') + \" W/m²\", \"\")"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Battery"
        },
        "position": {
          "basis": "auto"
        },
        "props": {
          "text": "",
          "style": {
            "color": "#5f6b76",
            "fontSize": "13px"
          }
        },
        "propConfig": {
          "meta.visible": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.reporting}, {view.custom.hasBattery}, false)"
              }
            }
          },
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "\"Battery \" + numberFormat({view.custom.batterySoc}, '0') + \"%  ·  \" + if({view.custom.batteryKw} > 0.5, \"discharging \" + numberFormat({view.custom.batteryKw} / 1000, '0.0') + \" MW\", if({view.custom.batteryKw} < -0.5, \"charging \" + numberFormat(abs({view.custom.batteryKw}) / 1000, '0.0') + \" MW\", \"idle\"))"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Status"
        },
        "position": {
          "basis": "auto"
        },
        "props": {
          "text": "",
          "style": {
            "color": "#ffffff",
            "fontSize": "12px",
            "fontWeight": "600",
            "padding": "2px 10px",
            "borderRadius": "10px",
            "width": "fit-content"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.reporting}, if({view.custom.output} > 0, \"Producing\", \"Standby\"), \"No data\")"
              }
            }
          },
          "props.style.backgroundColor": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.reporting}, if({view.custom.output} > 0, \"#2e7d32\", \"#5f6b76\"), \"#b3261e\")"
              }
            }
          }
        }
      }
    ]
  }
}
