# Copy to .env and fill in. .env is gitignored. Never commit real values.

# Pinned Ignition image tag (see docs/adr/0003)
IGNITION_IMAGE_TAG=8.3.9

# Local-only gateway admin account for the dev containers
GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=change-me

# Required by the Ignition image
ACCEPT_IGNITION_EULA=Y

# Edition is decided at the gateway's FIRST boot and cannot be changed later without wiping its volume.
#   standard = trial mode (2 hours, resettable), no license needed
#   maker    = free non-commercial license; needs a key and token per gateway (below)
IGNITION_EDITION=maker

# Maker leased licenses: one key and one activation token per gateway.
# Get them from your Inductive Automation account, Manage Licenses. NEVER commit real values.
HUB_LICENSE_KEY=XXXX-XXXX
HUB_ACTIVATION_TOKEN=paste-token-here
SITE1_LICENSE_KEY=XXXX-XXXX
SITE1_ACTIVATION_TOKEN=paste-token-here

# Ignition 8.3 REST API keys, one per gateway. Create in each gateway's web UI (search "API Keys").
# Sent as the X-Ignition-API-Token header by the admin tooling. NEVER commit real values.
HUB_API_TOKEN=paste-token-here
SITE1_API_TOKEN=paste-token-here

# PostgreSQL (local dev only)
POSTGRES_USER=fleet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fleet

# Time zone for the containers
TZ=America/Chicago

# Plant simulator (the sim container, ADR 0013). Not a secret. An optional UTC time that pins where simulated time
# starts every time the container starts, so the plant is producing, for example midday in west Texas.
# Leave it empty to follow the real clock (the plant sleeps at night).
SIM_START=2026-10-05T17:00:00Z
